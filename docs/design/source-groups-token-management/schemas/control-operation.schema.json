{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quota-throttle:control-operation:2",
  "title": "Control operation view version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "kind", "target_type", "target_id", "phase", "target_revision", "total_targets", "confirmed_targets", "error_code", "updated_at"],
  "properties": {
    "schema_version": {"const": 2},
    "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{15,63}$"},
    "kind": {"enum": ["ensure_member", "set_source_paused", "retire_member", "retire_source", "set_group_priorities", "sync_source_models", "set_group_pin", "clear_volcano_error", "update_volcano_policy", "discover_source_models"]},
    "target_type": {"enum": ["source", "group", "membership"]},
    "target_id": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "phase": {"enum": ["queued", "applying", "waiting", "partial", "unknown", "succeeded", "failed", "superseded"]},
    "target_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "total_targets": {"type": "integer", "minimum": 0, "maximum": 10000},
    "confirmed_targets": {"type": "integer", "minimum": 0, "maximum": 10000},
    "error_code": {"enum": [null, "invalid_input", "not_found", "revision_conflict", "idempotency_conflict", "queue_full", "not_ready", "binding_drift", "ambiguous_create", "auth_failed", "remote_rejected", "invalid_response", "rate_limited", "transport_unknown", "storage"]},
    "updated_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"enum": ["ensure_member", "retire_member"]}}},
      "then": {"properties": {"target_type": {"const": "membership"}}}
    },
    {
      "if": {"properties": {"kind": {"enum": ["set_source_paused", "retire_source", "sync_source_models", "clear_volcano_error", "update_volcano_policy", "discover_source_models"]}}},
      "then": {"properties": {"target_type": {"const": "source"}}}
    },
    {
      "if": {"properties": {"kind": {"enum": ["set_group_priorities", "set_group_pin"]}}},
      "then": {"properties": {"target_type": {"const": "group"}}}
    },
    {
      "if": {"properties": {"kind": {"enum": ["set_group_pin", "clear_volcano_error", "update_volcano_policy"]}}},
      "then": {"properties": {"phase": {"const": "succeeded"}, "total_targets": {"const": 0}, "confirmed_targets": {"const": 0}}}
    },
    {
      "if": {"properties": {"phase": {"const": "succeeded"}}},
      "then": {"properties": {"error_code": {"type": "null"}}}
    },
    {
      "if": {"properties": {"phase": {"const": "failed"}}},
      "then": {"properties": {"error_code": {"type": "string"}}}
    }
  ]
}
