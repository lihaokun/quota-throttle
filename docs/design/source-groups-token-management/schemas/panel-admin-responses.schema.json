  "$defs": {
    "original_catalog_snapshot": {"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:quota-throttle:catalog-snapshot:1","title":"Catalog snapshot version 1","type":"object","additionalProperties":false,"required":["schema_version","sources","groups","memberships"],"properties":{"schema_version":{"const":1},"sources":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/source"}},"groups":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/group"}},"memberships":{"type":"array","maxItems":10000,"items":{"$ref":"#/$defs/membership"}}},"$defs":{"id":{"type":"string","pattern":"^[1-9][0-9]{0,18}$"},"kind":{"enum":["glm","volcano"]},"name":{"type":"string","minLength":1,"maxLength":128,"pattern":"^\\S(?:[\\s\\S]*\\S)?$","not":{"pattern":"\u0000"}},"revision":{"type":"integer","minimum":1,"maximum":9007199254740991},"priority":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"timestamp":{"type":"integer","minimum":0,"maximum":9007199254740991},"source":{"type":"object","additionalProperties":false,"required":["source_id","type","name","note","manual_paused","retired_at","config_revision"],"properties":{"source_id":{"$ref":"#/$defs/id"},"type":{"$ref":"#/$defs/kind"},"name":{"$ref":"#/$defs/name"},"note":{"type":"string","maxLength":2048,"not":{"pattern":"\u0000"}},"manual_paused":{"type":"boolean"},"retired_at":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},"config_revision":{"$ref":"#/$defs/revision"}}},"group":{"type":"object","additionalProperties":false,"required":["group_id","newapi_group","name","type","revision","ready"],"properties":{"group_id":{"$ref":"#/$defs/id"},"newapi_group":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Za-z0-9_.-]+$","not":{"const":"auto"}},"name":{"$ref":"#/$defs/name"},"type":{"$ref":"#/$defs/kind"},"revision":{"$ref":"#/$defs/revision"},"ready":{"type":"boolean"}}},"membership":{"type":"object","additionalProperties":false,"required":["membership_id","source_id","group_id","channel_id","order","lifecycle","desired_priority","observed_status","observed_priority","applied_revision","retired_at"],"properties":{"membership_id":{"$ref":"#/$defs/id"},"source_id":{"$ref":"#/$defs/id"},"group_id":{"$ref":"#/$defs/id"},"channel_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"order":{"type":"integer","minimum":0,"maximum":9007199254740991},"lifecycle":{"enum":["planned","imported","created_disabled","ready","retired"]},"desired_priority":{"$ref":"#/$defs/priority"},"observed_status":{"enum":[null,1,2,3]},"observed_priority":{"anyOf":[{"$ref":"#/$defs/priority"},{"type":"null"}]},"applied_revision":{"anyOf":[{"$ref":"#/$defs/revision"},{"type":"null"}]},"retired_at":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]}},"allOf":[{"if":{"properties":{"lifecycle":{"const":"planned"}}},"then":{"properties":{"channel_id":{"type":"null"}}}},{"if":{"properties":{"lifecycle":{"enum":["imported","created_disabled","ready"]}}},"then":{"properties":{"channel_id":{"$ref":"#/$defs/id"}}}},{"if":{"properties":{"lifecycle":{"const":"retired"}}},"then":{"properties":{"retired_at":{"$ref":"#/$defs/timestamp"}}},"else":{"properties":{"retired_at":{"type":"null"}}}}]}}},
    "original_control_operation": {"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:quota-throttle:control-operation:3","title":"Control operation view version 3","type":"object","additionalProperties":false,"required":["schema_version","operation_id","kind","target_type","target_id","phase","target_revision","total_targets","confirmed_targets","error_code","updated_at"],"properties":{"schema_version":{"const":3},"operation_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{15,63}$"},"kind":{"enum":["ensure_member","set_source_paused","retire_member","retire_source","set_group_priorities","sync_source_models","set_group_pin","clear_volcano_error","update_volcano_policy","discover_source_models","create_token","set_token_enabled","delete_token"]},"target_type":{"enum":["source","group","membership","token"]},"target_id":{"type":"string","pattern":"^[1-9][0-9]{0,18}$"},"phase":{"enum":["queued","applying","waiting","partial","unknown","succeeded","failed","superseded"]},"target_revision":{"type":"integer","minimum":1,"maximum":9007199254740991},"total_targets":{"type":"integer","minimum":0,"maximum":10000},"confirmed_targets":{"type":"integer","minimum":0,"maximum":10000},"error_code":{"enum":[null,"invalid_input","not_found","revision_conflict","idempotency_conflict","queue_full","not_ready","binding_drift","ambiguous_create","auth_failed","remote_rejected","invalid_response","rate_limited","transport_unknown","storage"]},"updated_at":{"type":"integer","minimum":0,"maximum":9007199254740991}},"allOf":[{"if":{"properties":{"kind":{"enum":["create_token","set_token_enabled","delete_token"]}}},"then":{"properties":{"target_type":{"const":"token"},"total_targets":{"const":1},"confirmed_targets":{"maximum":1},"phase":{"not":{"enum":["partial","superseded"]}}}}},{"if":{"properties":{"kind":{"enum":["ensure_member","retire_member"]}}},"then":{"properties":{"target_type":{"const":"membership"}}}},{"if":{"properties":{"kind":{"enum":["set_source_paused","retire_source","sync_source_models","clear_volcano_error","update_volcano_policy","discover_source_models"]}}},"then":{"properties":{"target_type":{"const":"source"}}}},{"if":{"properties":{"kind":{"enum":["set_group_priorities","set_group_pin"]}}},"then":{"properties":{"target_type":{"const":"group"}}}},{"if":{"properties":{"kind":{"enum":["set_group_pin","clear_volcano_error","update_volcano_policy"]}}},"then":{"properties":{"phase":{"const":"succeeded"},"total_targets":{"const":0},"confirmed_targets":{"const":0}}}},{"if":{"properties":{"phase":{"const":"succeeded"}}},"then":{"properties":{"error_code":{"type":"null"}}}},{"if":{"properties":{"phase":{"const":"failed"}}},"then":{"properties":{"error_code":{"type":"string"}}}}]},
    "original_token_identity": {"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:quota-throttle:token-identity:1","title":"Managed token identity version 1","type":"object","additionalProperties":false,"required":["schema_version","token_id","native_token_id","owner_user_id","owner_scope","origin","group_id","explicit_group","display_name","revision","create_state","created_at","deleted_at"],"properties":{"schema_version":{"const":1},"token_id":{"type":"string","pattern":"^[1-9][0-9]{0,18}$"},"native_token_id":{"type":["string","null"],"pattern":"^[1-9][0-9]{0,18}$"},"owner_user_id":{"type":"string","pattern":"^[1-9][0-9]{0,18}$"},"owner_scope":{"enum":["issuer","legacy_admin"]},"origin":{"enum":["created","imported"]},"group_id":{"type":["string","null"],"pattern":"^[1-9][0-9]{0,18}$"},"explicit_group":{"type":"string","maxLength":256},"display_name":{"type":"string","minLength":1,"maxLength":256},"revision":{"type":"integer","minimum":1,"maximum":9007199254740991},"create_state":{"enum":["never","may_have_been_sent","resolved"]},"created_at":{"type":"integer","minimum":0,"maximum":9007199254740991},"deleted_at":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991}},"allOf":[{"if":{"properties":{"origin":{"const":"created"}}},"then":{"properties":{"owner_scope":{"const":"issuer"},"group_id":{"type":"string"},"explicit_group":{"pattern":"^[A-Za-z0-9_.-]{1,64}$","not":{"const":"auto"}}}}},{"if":{"properties":{"create_state":{"const":"resolved"}}},"then":{"properties":{"native_token_id":{"type":"string"}}},"else":{"properties":{"native_token_id":{"type":"null"},"origin":{"const":"created"}}}},{"if":{"properties":{"deleted_at":{"type":"integer"}}},"then":{"properties":{"native_token_id":{"type":"string"},"create_state":{"const":"resolved"}}}}]},
    "original_native_token": {"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:quota-throttle:native-token:1","title":"Safe native token view version 1","type":"object","additionalProperties":false,"required":["schema_version","token_id","owner_user_id","owner_scope","name","masked_key","explicit_group","effective_group","status","created_at","expires_at","remaining_quota","used_quota","unlimited_quota","model_limits_enabled","model_limits","allow_ips","cross_group_retry"],"properties":{"schema_version":{"const":1},"token_id":{"type":"string","pattern":"^[1-9][0-9]{0,18}$"},"owner_user_id":{"type":"string","pattern":"^[1-9][0-9]{0,18}$"},"owner_scope":{"enum":["issuer","legacy_admin"]},"name":{"type":"string"},"masked_key":{"type":"string","pattern":"^.{0,4}\\*+.{0,4}$"},"explicit_group":{"type":"string"},"effective_group":{"type":"string","minLength":1},"status":{"enum":["enabled","disabled","expired","exhausted"]},"created_at":{"type":"integer","minimum":0,"maximum":9007199254740991},"expires_at":{"type":["integer","null"],"minimum":0,"maximum":9007199254740991},"remaining_quota":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"used_quota":{"type":"integer","minimum":0,"maximum":9007199254740991},"unlimited_quota":{"type":"boolean"},"model_limits_enabled":{"type":"boolean"},"model_limits":{"type":"string"},"allow_ips":{"type":["string","null"]},"cross_group_retry":{"type":"boolean"}}},
    "original_group_check": {"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:quota-throttle:group-check:1","title":"Group configuration check version 1","type":"object","additionalProperties":false,"required":["schema_version","group_id","revision","ready","error_code"],"properties":{"schema_version":{"const":1},"group_id":{"type":"string","pattern":"^[1-9][0-9]{0,18}$"},"revision":{"type":"integer","minimum":1,"maximum":9007199254740991},"ready":{"type":"boolean"},"error_code":{"enum":[null,"invalid_input","not_found","revision_conflict","idempotency_conflict","queue_full","not_ready","binding_drift","ambiguous_create","auth_failed","remote_rejected","invalid_response","rate_limited","transport_unknown","storage"]}},"allOf":[{"if":{"properties":{"ready":{"const":true}}},"then":{"properties":{"error_code":{"const":null}}}},{"if":{"properties":{"ready":{"const":false}}},"then":{"properties":{"error_code":{"not":{"const":null}}}}}]},
    "original_group_references": {"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:quota-throttle:group-references:1","title":"Known local group references version 1","type":"object","additionalProperties":false,"required":["schema_version","group_id","active_memberships","historical_memberships","live_tokens","pending_creations","historical_tokens","unknown_group_tokens","known_local_only","deletion_authorized"],"properties":{"schema_version":{"const":1},"group_id":{"type":"string","pattern":"^[1-9][0-9]{0,18}$"},"active_memberships":{"$ref":"#/$defs/count"},"historical_memberships":{"$ref":"#/$defs/count"},"live_tokens":{"$ref":"#/$defs/count"},"pending_creations":{"$ref":"#/$defs/count"},"historical_tokens":{"$ref":"#/$defs/count"},"unknown_group_tokens":{"$ref":"#/$defs/count"},"known_local_only":{"const":true},"deletion_authorized":{"const":false}},"$defs":{"count":{"type":"integer","minimum":0,"maximum":10000}}},
    "id": {"type":"string","pattern":"^[1-9][0-9]{0,18}$","description":"还须按i64正整数解析，不接受溢出；schema模式不替代数值检查。"},
    "revision": {"type":"integer","minimum":1,"maximum":9007199254740991},
    "runtimeRevision": {"type":"integer","minimum":0,"maximum":9007199254740991},
    "timestamp": {"type":"integer","minimum":0,"maximum":9007199254740991},
    "model": {"type":"string","minLength":1,"not":{"pattern":"[,\\u0000]"},"description":"原模型规则trim/去重/最终非空；总请求仍受1MiB限制。"},
    "IdFilter": {"oneOf":[{"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"const":"any"}}},{"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"const":"unknown"}}},{"type":"object","additionalProperties":false,"required":["mode","value"],"properties":{"mode":{"const":"exact"},"value":{"$ref":"#/$defs/id"}}}]},
    "ModelFilter": {"oneOf":[{"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"const":"any"}}},{"type":"object","additionalProperties":false,"required":["mode"],"properties":{"mode":{"const":"unknown"}}},{"type":"object","additionalProperties":false,"required":["mode","value"],"properties":{"mode":{"const":"exact"},"value":{"type":"string","minLength":1,"maxLength":256,"not":{"pattern":"[\\u0000-\\u001f\\u007f-\\u009f]"},"description":"原valid_label：UTF-8<=256字节且无Unicode控制字符；不要求trim不变。"}}}]},
    "ownerScope": {"enum":["issuer","legacy_admin"]},
    "SourceCreated": {"type":"object","additionalProperties":false,"required":["schema_version","source","model_origin"],"properties":{"schema_version":{"const":1},"source":{"$ref":"urn:quota-throttle:catalog-snapshot:1#/$defs/source"},"model_origin":{"enum":["discovered","manual","fallback"]}}},
    "GroupCreated": {"type":"object","additionalProperties":false,"required":["schema_version","group"],"properties":{"schema_version":{"const":1},"group":{"$ref":"urn:quota-throttle:catalog-snapshot:1#/$defs/group"}}},
    "MemberPlanned": {"type":"object","additionalProperties":false,"required":["schema_version","membership"],"properties":{"schema_version":{"const":1},"membership":{"$ref":"urn:quota-throttle:catalog-snapshot:1#/$defs/membership"}}},
    "SourceModels": {"type":"object","additionalProperties":false,"required":["schema_version","source_id","source_revision","models"],"properties":{"schema_version":{"const":1},"source_id":{"$ref":"#/$defs/id"},"source_revision":{"$ref":"#/$defs/revision"},"models":{"type":"array","minItems":1,"maxItems":1000,"items":{"$ref":"#/$defs/model"},"uniqueItems":true}}},
    "IdentityPage": {"type":"object","additionalProperties":false,"required":["schema_version","items","after","next_after"],"properties":{"schema_version":{"const":1},"items":{"type":"array","minItems":0,"maxItems":100,"items":{"$ref":"urn:quota-throttle:token-identity:1"}},"after":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"next_after":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]}}},
    "NativePage": {"type":"object","additionalProperties":false,"required":["schema_version","owner_scope","page","page_size","total","items"],"properties":{"schema_version":{"const":1},"owner_scope":{"$ref":"#/$defs/ownerScope"},"page":{"type":"integer","minimum":1,"maximum":100},"page_size":{"const":100},"total":{"type":"integer","minimum":0,"maximum":10000},"items":{"type":"array","minItems":0,"maxItems":100,"items":{"$ref":"urn:quota-throttle:native-token:1"}}}},
    "TokenReveal": {"type":"object","additionalProperties":false,"required":["schema_version","token_id","key"],"properties":{"schema_version":{"const":1},"token_id":{"$ref":"#/$defs/id"},"key":{"type":"string","pattern":"^sk-[A-Za-z0-9]{16,128}$"}}},
    "ResolvedFilter": {"type":"object","additionalProperties":false,"required":["source_id","group_id","native_token_id","model"],"properties":{"source_id":{"$ref":"#/$defs/IdFilter"},"group_id":{"$ref":"#/$defs/IdFilter"},"native_token_id":{"$ref":"#/$defs/IdFilter"},"model":{"$ref":"#/$defs/ModelFilter"}}},
    "ResolvedQuery": {"type":"object","additionalProperties":false,"required":["from","to","utc_offset_minutes","grain","filter"],"properties":{"from":{"$ref":"#/$defs/timestamp"},"to":{"$ref":"#/$defs/timestamp"},"utc_offset_minutes":{"type":"integer","minimum":-720,"maximum":840},"grain":{"enum":["hour","day"]},"filter":{"$ref":"#/$defs/ResolvedFilter"}}},
    "ScanWindow": {"type":"object","additionalProperties":false,"required":["from","to"],"properties":{"from":{"$ref":"#/$defs/timestamp"},"to":{"$ref":"#/$defs/revision"}}},
    "ScanProgress": {"type":"object","additionalProperties":false,"required":["lane","generation","window","next_page","phase","last_observed_at","fault"],"properties":{"lane":{"enum":["recent","history"]},"generation":{"$ref":"#/$defs/runtimeRevision"},"window":{"anyOf":[{"$ref":"#/$defs/ScanWindow"},{"type":"null"}]},"next_page":{"$ref":"#/$defs/revision"},"phase":{"enum":["idle","scanning","scanned","stalled"]},"last_observed_at":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},"fault":{"enum":[null,"transport","invalid_page","invalid_fact","conflicting_identity","binding_changed","history_unavailable","resource_limit","clock"]}},"allOf":[{"if":{"properties":{"phase":{"const":"idle"}}},"then":{"properties":{"generation":{"const":0},"window":{"type":"null"},"next_page":{"const":1},"last_observed_at":{"type":"null"},"fault":{"type":"null"}}},"else":{"properties":{"generation":{"$ref":"#/$defs/revision"},"window":{"$ref":"#/$defs/ScanWindow"}}}},{"if":{"properties":{"phase":{"const":"scanning"}}},"then":{"properties":{"fault":{"type":"null"}}}},{"if":{"properties":{"phase":{"const":"scanned"}}},"then":{"properties":{"fault":{"type":"null"},"last_observed_at":{"$ref":"#/$defs/timestamp"}}}},{"if":{"properties":{"phase":{"const":"stalled"}}},"then":{"properties":{"fault":{"not":{"type":"null"}},"last_observed_at":{"$ref":"#/$defs/timestamp"}}}}]},
    "Ledger": {"type":"object","additionalProperties":false,"required":["revision","initial_requested_from","scans"],"properties":{"revision":{"$ref":"#/$defs/revision"},"initial_requested_from":{"anyOf":[{"$ref":"#/$defs/timestamp"},{"type":"null"}]},"scans":{"type":"array","minItems":2,"maxItems":2,"prefixItems":[{"allOf":[{"$ref":"#/$defs/ScanProgress"},{"properties":{"lane":{"const":"recent"}}}]},{"allOf":[{"$ref":"#/$defs/ScanProgress"},{"properties":{"lane":{"const":"history"}}}]}],"items":false}},"allOf":[{"if":{"properties":{"initial_requested_from":{"type":"null"}}},"then":{"properties":{"scans":{"items":{"properties":{"phase":{"const":"idle"}}}}}}}]},
    "Totals": {"type":"object","additionalProperties":false,"required":["input","output","total","consumption_rows"],"properties":{"input":{"$ref":"#/$defs/runtimeRevision"},"output":{"$ref":"#/$defs/runtimeRevision"},"total":{"$ref":"#/$defs/runtimeRevision"},"consumption_rows":{"$ref":"#/$defs/runtimeRevision"}}},
    "ModelUsage": {"type":"object","additionalProperties":false,"required":["model","usage"],"properties":{"model":{"anyOf":[{"type":"string","minLength":1,"maxLength":256,"not":{"pattern":"[\\u0000-\\u001f\\u007f-\\u009f]"}},{"type":"null"}]},"usage":{"$ref":"#/$defs/Totals"}}},
    "TokenUsage": {"type":"object","additionalProperties":false,"required":["native_token_id","usage"],"properties":{"native_token_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"usage":{"$ref":"#/$defs/Totals"}}},
    "UsageBucket": {"type":"object","additionalProperties":false,"required":["from","to","total","models"],"properties":{"from":{"$ref":"#/$defs/timestamp"},"to":{"$ref":"#/$defs/timestamp"},"total":{"$ref":"#/$defs/Totals"},"models":{"type":"array","minItems":0,"maxItems":1024,"items":{"$ref":"#/$defs/ModelUsage"}}}},
    "UsageReport": {"type":"object","additionalProperties":false,"required":["total","models","tokens","buckets"],"properties":{"total":{"$ref":"#/$defs/Totals"},"models":{"type":"array","minItems":0,"maxItems":1024,"items":{"$ref":"#/$defs/ModelUsage"}},"tokens":{"type":"array","minItems":0,"maxItems":4096,"items":{"$ref":"#/$defs/TokenUsage"}},"buckets":{"type":"array","minItems":0,"maxItems":745,"items":{"$ref":"#/$defs/UsageBucket"}}}},
    "UsageSnapshot": {"type":"object","additionalProperties":false,"required":["schema_version","query","ledger","usage"],"properties":{"schema_version":{"const":1},"query":{"$ref":"#/$defs/ResolvedQuery"},"ledger":{"$ref":"#/$defs/Ledger"},"usage":{"anyOf":[{"$ref":"#/$defs/UsageReport"},{"type":"null"}]}},"allOf":[{"if":{"properties":{"ledger":{"properties":{"initial_requested_from":{"type":"null"}}}}},"then":{"properties":{"usage":{"type":"null"}}},"else":{"properties":{"usage":{"$ref":"#/$defs/UsageReport"}}}}]},
    "AdminError": {"type":"object","additionalProperties":false,"required":["schema_version","error","existing_source_id"],"properties":{"schema_version":{"const":1},"error":{"enum":["invalid_input","not_found","revision_conflict","idempotency_conflict","queue_full","not_ready","binding_drift","ambiguous_create","auth_failed","remote_rejected","invalid_response","rate_limited","transport_unknown","storage","type_mismatch","duplicate_source","duplicate_group","duplicate_membership","retired","channel_conflict","invalid_query","limit_exceeded","arithmetic_overflow","query_cancelled","query_timeout","dry_run","result_unconfirmed","response_too_large"]},"existing_source_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]}},"allOf":[{"if":{"properties":{"error":{"const":"duplicate_source"}}},"then":{"properties":{"existing_source_id":{"$ref":"#/$defs/id"}}},"else":{"properties":{"existing_source_id":{"type":"null"}}}}]}
  }
}
