{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quota-throttle:native-token:1",
  "title": "Safe native token view version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "token_id", "owner_user_id", "owner_scope", "name", "masked_key", "explicit_group", "effective_group", "status", "created_at", "expires_at", "remaining_quota", "used_quota", "unlimited_quota", "model_limits_enabled", "model_limits", "allow_ips", "cross_group_retry"],
  "properties": {
    "schema_version": {"const": 1},
    "token_id": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "owner_user_id": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "owner_scope": {"enum": ["issuer", "legacy_admin"]},
    "name": {"type": "string"},
    "masked_key": {"type": "string", "pattern": "^.{0,4}\\*+.{0,4}$"},
    "explicit_group": {"type": "string"},
    "effective_group": {"type": "string", "minLength": 1},
    "status": {"enum": ["enabled", "disabled", "expired", "exhausted"]},
    "created_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "expires_at": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "remaining_quota": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
    "used_quota": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "unlimited_quota": {"type": "boolean"},
    "model_limits_enabled": {"type": "boolean"},
    "model_limits": {"type": "string"},
    "allow_ips": {"type": ["string", "null"]},
    "cross_group_retry": {"type": "boolean"}
  }
}
