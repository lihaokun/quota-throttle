{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quota-throttle:token-identity:1",
  "title": "Managed token identity version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "token_id", "native_token_id", "owner_user_id", "owner_scope", "origin", "group_id", "explicit_group", "display_name", "revision", "create_state", "created_at", "deleted_at"],
  "properties": {
    "schema_version": {"const": 1},
    "token_id": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "native_token_id": {"type": ["string", "null"], "pattern": "^[1-9][0-9]{0,18}$"},
    "owner_user_id": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "owner_scope": {"enum": ["issuer", "legacy_admin"]},
    "origin": {"enum": ["created", "imported"]},
    "group_id": {"type": ["string", "null"], "pattern": "^[1-9][0-9]{0,18}$"},
    "explicit_group": {"type": "string", "maxLength": 256},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "create_state": {"enum": ["never", "may_have_been_sent", "resolved"]},
    "created_at": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "deleted_at": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991}
  },
  "allOf": [
    {"if": {"properties": {"origin": {"const": "created"}}}, "then": {"properties": {"owner_scope": {"const": "issuer"}, "group_id": {"type": "string"}, "explicit_group": {"pattern": "^[A-Za-z0-9_.-]{1,64}$", "not": {"const": "auto"}}}}},
    {"if": {"properties": {"create_state": {"const": "resolved"}}}, "then": {"properties": {"native_token_id": {"type": "string"}}}, "else": {"properties": {"native_token_id": {"type": "null"}, "origin": {"const": "created"}}}},
    {"if": {"properties": {"deleted_at": {"type": "integer"}}}, "then": {"properties": {"native_token_id": {"type": "string"}, "create_state": {"const": "resolved"}}}}
  ]
}
